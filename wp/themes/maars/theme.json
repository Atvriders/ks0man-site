{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "68ch",
			"wideSize": "1100px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": true,
			"palette": [
				{
					"slug": "navy",
					"name": "MAARS navy",
					"color": "#00008C"
				},
				{
					"slug": "magenta",
					"name": "Newsletter magenta",
					"color": "#990066"
				},
				{
					"slug": "lavender",
					"name": "Notice lavender",
					"color": "#DBDBFB"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#14142B"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#FFFFFF"
				},
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#FBFBFD"
				},
				{
					"slug": "alarm",
					"name": "Alarm",
					"color": "#A5171B"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": {
				"minViewportWidth": "320px",
				"maxViewportWidth": "1100px"
			},
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", \"Bitstream Charter\", \"Century Schoolbook\", \"New Century Schoolbook\", Georgia, \"Times New Roman\", Times, serif"
				},
				{
					"slug": "text",
					"name": "Text sans",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif"
				},
				{
					"slug": "data",
					"name": "Data mono",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", \"Cascadia Mono\", \"Segoe UI Mono\", Menlo, Consolas, \"Liberation Mono\", \"DejaVu Sans Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "1rem",
					"fluid": {
						"min": "0.9375rem",
						"max": "1rem"
					}
				},
				{
					"slug": "medium",
					"name": "Text",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "1.25rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Section display",
					"size": "2.5rem",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				},
				{
					"slug": "dateline",
					"name": "Dateline",
					"size": "3.25rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4rem"
					}
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"units": [ "px", "em", "rem", "%", "ch", "vw", "vh" ],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1 — Hairline",
					"size": "clamp(0.375rem, 0.35rem + 0.15vw, 0.5rem)"
				},
				{
					"slug": "30",
					"name": "2 — Tight",
					"size": "clamp(0.75rem, 0.7rem + 0.25vw, 1rem)"
				},
				{
					"slug": "40",
					"name": "3 — Default",
					"size": "clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem)"
				},
				{
					"slug": "50",
					"name": "4 — Comfortable",
					"size": "clamp(1.75rem, 1.5rem + 1.2vw, 2.75rem)"
				},
				{
					"slug": "60",
					"name": "5 — Section",
					"size": "clamp(2.5rem, 2rem + 2.4vw, 4rem)"
				},
				{
					"slug": "70",
					"name": "6 — Chapter",
					"size": "clamp(3.5rem, 2.75rem + 3.6vw, 6rem)"
				},
				{
					"slug": "80",
					"name": "7 — Rule off",
					"size": "clamp(5rem, 3.75rem + 6vw, 9rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "panel",
					"name": "Panel",
					"shadow": "0 1px 0 rgba(20, 20, 43, 0.06), 0 1px 3px rgba(20, 20, 43, 0.08)"
				},
				{
					"slug": "raised",
					"name": "Raised",
					"shadow": "0 2px 4px rgba(20, 20, 43, 0.10), 0 8px 20px rgba(20, 20, 43, 0.08)"
				}
			]
		},
		"dimensions": {
			"minHeight": true
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|ground",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|navy"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|navy"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var:preset|color|navy"
					},
					"outline": {
						"color": "var:preset|color|navy",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":active": {
					"color": {
						"text": "var:preset|color|magenta"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|navy"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em",
					"fontFamily": "var:preset|font-family|text",
					"fontWeight": "700"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em",
					"fontFamily": "var:preset|font-family|text",
					"fontWeight": "700"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontFamily": "var:preset|font-family|text",
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|navy",
					"text": "var:preset|color|paper"
				},
				"border": {
					"radius": "4px",
					"color": "var:preset|color|navy",
					"style": "solid",
					"width": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|text",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|magenta",
						"text": "var:preset|color|paper"
					},
					"border": {
						"color": "var:preset|color|magenta"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|magenta",
						"text": "var:preset|color|paper"
					},
					"outline": {
						"color": "var:preset|color|navy",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|navy",
						"text": "var:preset|color|paper"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|ink"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.5"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|paper"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.1"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var:preset|font-family|data",
					"fontSize": "var:preset|font-size|small"
				},
				"color": {
					"text": "var:preset|color|magenta"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|navy"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|magenta",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|30"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large"
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|lavender",
					"text": "var:preset|color|ink"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|data",
					"fontSize": "var:preset|font-size|small"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|30",
						"right": "var:preset|spacing|30"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Masthead",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Colophon",
			"area": "footer"
		}
	]
}
